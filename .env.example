# =============================================================================
# CHAT BACKEND - CONFIGURACIÓN DE ENTORNO
# =============================================================================
# Copia este archivo a .env y rellena los valores reales
# NO commitees el archivo .env real
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
SERVER_PORT=8080
# Para un futuro cliente web: lista de orígenes concretos separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=chat_mattu
POSTGRES_USER=chat_mattu
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_PORT=5432

# URL JDBC (para Spring)
DB_URL=jdbc:postgresql://localhost:5432/chat_mattu
DB_USERNAME=chat_mattu
DB_PASSWORD=change_me_secure_password

# -----------------------------------------------------------------------------
# SEGURIDAD JWT
# -----------------------------------------------------------------------------
# MÍNIMO 32 caracteres (256 bits para HS256)
# Genera uno seguro: openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars_long

# -----------------------------------------------------------------------------
# SUPABASE STORAGE (para avatars, banners, iconos, adjuntos)
# -----------------------------------------------------------------------------
# Obtén estos valores en: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_ATTACHMENT_BUCKET=attachments

# -----------------------------------------------------------------------------
# CIFRADO MENSAJES (AES-256-GCM)
# -----------------------------------------------------------------------------
# Clave de 32 bytes en Base64
# Genera: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=replace_with_your_existing_or_generated_32_byte_base64_key

# -----------------------------------------------------------------------------
# REDIS (para rate limiting, presence, WebSocket broker - Fase 2)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# OPCIONALES
# -----------------------------------------------------------------------------
# LOG_LEVEL=DEBUG
# SPRING_PROFILES_ACTIVE=local
